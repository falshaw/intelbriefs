# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_password_here
REDIS_PASSWORD=your_secure_password_here

# Prisma CLI and seed, run from the host (schema push needs the owner account,
# not the app user). Same password as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://intelbriefs:your_secure_password_here@127.0.0.1:5438/intelbriefs_db

# Auth (NextAuth v5)
# Generate with: openssl rand -base64 32 (must be >= 32 chars)
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3006

# Mock Auth (set to true to bypass real auth in development)
USE_MOCK_AUTH=false
MOCK_AUTH_USER_ID=default-user-id
MOCK_AUTH_EMAIL=default@intelbriefs.local
MOCK_AUTH_NAME=IntelBriefs Admin
MOCK_AUTH_ROLE=ADMIN

# LLM: "ollama" (default, local) or "claude" (optional host-side gateway)
LLM_PROVIDER=ollama

# Ollama on the host (Docker reaches it via host.docker.internal)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Research APIs
TAVILY_API_KEY=
EXA_API_KEY=

# CRM integration (optional; leave empty to turn it off)
CRM_API_URL=
CRM_API_KEY=

# Least-privilege app DB user (created by postgres/init-app-user.sh)
# Generate with: openssl rand -base64 32
INTELBRIEFS_APP_PASSWORD=your_app_db_password_here

# Compose fail-fasts without it. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional LLM gateway token (only with LLM_PROVIDER=claude)
CLAUDE_BRIDGE_TOKEN=

# Shared secret for /api/cron/* (intelbriefs-cron sidecar)
CRON_SECRET=
